<div class="nav-header-banner d-flex align-center gap-3">
    <MudAvatar Variant="Variant.Filled" Size="Size.Medium" Style="background: rgba(197, 160, 89, 0.2); border: 2px solid #c5a059;">
        <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Medium" Style="color: #d4af37;" />
    </MudAvatar>
    <div>
        <MudText Typo="Typo.subtitle1" Class="fw-bold lh-sm text-white">مكتب المحاماة والخدمات</MudText>
        <MudText Typo="Typo.caption" Style="color: #c5a059;" Class="fw-bold">النظام القانوني المتقدم v1.0</MudText>
    </div>
</div>

<MudNavMenu Bordered="false" Rounded="true" Margin="Margin.Dense" Class="pa-2">
    
    <!-- 🏠 لوحة التحكم الرئيسية -->
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary" OnClick="HandleItemClick">
        لوحة التحكم الرئيسية
    </MudNavLink>

    <MudDivider Class="my-2" />

    <!-- ⚖️ مجموعة القضايا والجلسات (قابلة للتوسع) -->
    <MudNavGroup Title="القضايا والعمليات القضائية" Icon="@Icons.Material.Filled.Gavel" IconColor="Color.Warning" Expanded="true">
        <MudNavLink Href="cases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderSpecial" IconColor="Color.Warning" OnClick="HandleItemClick">
            ملفات القضايا والدعاوى
        </MudNavLink>

        <MudNavLink Href="hearings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth" IconColor="Color.Error" OnClick="HandleItemClick">
            تقويم وجلسات المحاكم
        </MudNavLink>

        <MudNavLink Href="power-of-attorney" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment" IconColor="Color.Secondary" OnClick="HandleItemClick">
            التوكيلات والتفويضات
        </MudNavLink>
    </MudNavGroup>

    <!-- 👥 مجموعة الموكلين والخدمات (قابلة للتوسع) -->
    <MudNavGroup Title="إدارة الموكلين والعملاء" Icon="@Icons.Material.Filled.People" IconColor="Color.Info" Expanded="false">
        <MudNavLink Href="clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch" IconColor="Color.Info" OnClick="HandleItemClick">
            سجل الموكلين (أفراد / شركات)
        </MudNavLink>

        <MudNavLink Href="consultations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Forum" IconColor="Color.Tertiary" OnClick="HandleItemClick">
            الاستشارات القانونية
        </MudNavLink>
    </MudNavGroup>

    <!-- 💰 مجموعة الشئون المالية (قابلة للتوسع) -->
    <MudNavGroup Title="الشئون المالية والفواتير" Icon="@Icons.Material.Filled.AccountBalanceWallet" IconColor="Color.Success" Expanded="false">
        <MudNavLink Href="finance" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong" IconColor="Color.Success" OnClick="HandleItemClick">
            الشؤون المالية والتحصيل
        </MudNavLink>
    </MudNavGroup>

    <!-- 📁 مجموعة الأرشيف والمهام (قابلة للتوسع) -->
    <MudNavGroup Title="الأرشيف والمهام والإشعارات" Icon="@Icons.Material.Filled.FolderCopy" IconColor="Color.Default" Expanded="false">
        <MudNavLink Href="documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description" IconColor="Color.Default" OnClick="HandleItemClick">
            الأرشيف والمستندات
        </MudNavLink>

        <MudNavLink Href="tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Checklist" IconColor="Color.Info" OnClick="HandleItemClick">
            المهام والمتابعات
        </MudNavLink>

        <MudNavLink Href="notifications" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications" IconColor="Color.Warning" OnClick="HandleItemClick">
            مركز الإشعارات والتنبيهات
        </MudNavLink>

        <MudNavLink Href="reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment" IconColor="Color.Primary" OnClick="HandleItemClick">
            التقارير والإحصائيات
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <!-- ⚙️ مجموعة ضبط النظام (قابلة للتوسع) -->
    <MudNavGroup Title="إدارة النظام والضبط" Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Secondary" Expanded="false">
        <MudNavLink Href="users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts" IconColor="Color.Default" OnClick="HandleItemClick">
            إدارة المستخدمين والصلاحيات
        </MudNavLink>
    </MudNavGroup>

</MudNavMenu>

@code {
    [Parameter] public EventCallback OnItemClick { get; set; }

    private async Task HandleItemClick()
    {
        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync();
        }
    }
}
