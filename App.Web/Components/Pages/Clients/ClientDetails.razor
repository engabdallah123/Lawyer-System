        var dialog = await DialogService.ShowAsync<CreatePaymentDialog>("تسجيل سند قبض جديد", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadClientDetails();
    }

    private async Task OpenNewPowerOfAttorneyDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreatePowerOfAttorneyDialog>("إضافة توكيل رسمي جديد للموكل", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadClientDetails();
