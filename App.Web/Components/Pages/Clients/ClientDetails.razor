@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private ClientDetailsDto? _client;
    private List<CaseDto> _cases = [];
    private List<FeeAgreementDto> _agreements = [];
    private List<PaymentDto> _payments = [];
    private List<PowerOfAttorneyDto> _powerOfAttorneys = [];

    private decimal _totalAgreements => _agreements.Sum(a => a.TotalAmount);
    private decimal _totalPaid => _payments.Sum(p => p.Amount);
    private decimal _remainingBalance => Math.Max(0, _totalAgreements - _totalPaid);

    protected override async Task OnInitializedAsync()
    {
        await LoadClientDetails();
    }

    private async Task LoadClientDetails()
    {
        _isLoading = true;
        try
        {
            var clientResult = await Mediator.Send(new GetClientByIdQuery(Id));
            if (clientResult.IsSuccess && clientResult.Value != null)
            {
                _client = clientResult.Value;

                var casesTask = Mediator.Send(new GetCasesQuery(ClientId: Id, PageSize: 100));
                var agreementsTask = Mediator.Send(new GetFeeAgreementsQuery(ClientId: Id, PageSize: 100));
                var paymentsTask = Mediator.Send(new GetPaymentsQuery(ClientId: Id, PageSize: 100));
                var poaTask = Mediator.Send(new GetPowerOfAttorneysQuery(ClientId: Id, PageSize: 100));

                await Task.WhenAll(casesTask, agreementsTask, paymentsTask, poaTask);

                if (casesTask.Result.IsSuccess && casesTask.Result.Value != null)
                    _cases = casesTask.Result.Value.ToList();

                if (agreementsTask.Result.IsSuccess && agreementsTask.Result.Value != null)
                    _agreements = agreementsTask.Result.Value.ToList();

                if (paymentsTask.Result.IsSuccess && paymentsTask.Result.Value != null)
                    _payments = paymentsTask.Result.Value.ToList();

                if (poaTask.Result.IsSuccess && poaTask.Result.Value != null)
                    _powerOfAttorneys = poaTask.Result.Value.ToList();
            }
            else
            {
                _client = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تحميل تفاصيل الموكل: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenEditClientDialog()
    {
        if (_client is null) return;
        var clientDto = new ClientDto(
            _client.Id,
            _client.ClientType,
            _client.FullName,
            _client.CompanyName,
            _client.NationalId,
            _client.CommercialRegister,
            _client.Phone,
            _client.Mobile,
            _client.Email,
            _client.Address,
            _client.City,
            _client.Notes,
            _client.IsActive,
            _client.CreatedAt);

        var parameters = new DialogParameters { ["ClientToEdit"] = clientDto };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ClientFormDialog>("تعديل بيانات الموكل", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadClientDetails();
    }

    private async Task OpenNewCaseDialog()
    {
        var parameters = new DialogParameters { ["DefaultClientId"] = (Guid?)Id };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateCaseDialog>("فتح ملف قضية جديدة للموكل", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadClientDetails();
    }

    private async Task OpenNewFeeAgreementDialog()
