@using global::App.Application.Cases.DTOs
@using global::App.Application.Cases.Queries.GetCases
@using global::App.Application.Clients.DTOs
@using global::App.Application.Clients.Queries.GetClients
@using global::App.Application.Documents.Commands.CreateDocument
@using global::App.Application.Lookups.DTOs
@using global::App.Application.Lookups.Queries.GetDocumentTypes
@using global::App.Domain.Clients.Enums
@using Microsoft.AspNetCore.Http
@using Shared.Application.IService
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IFileService FileService
@inject CustomAuthenticationStateProvider AuthStateProvider

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <!-- Real File Upload Box -->
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-4 border-dashed rounded-lg bg-surface-subtle text-center">
                        <InputFile id="docFileInput" OnChange="OnFileSelected" class="d-none" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xlsx,.txt" />
                        <MudButton HtmlTag="label"
                                   for="docFileInput"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   Class="mb-2">
                            اختيار مستند / ملف من جهازك
                        </MudButton>

                        @if (_selectedBrowserFile != null)
                        {
                            <div class="d-flex align-center justify-center gap-2 mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Class="fw-bold text-success">@_selectedBrowserFile.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@FormatFileSize(_selectedBrowserFile.Size)</MudChip>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">الصيغ المدعومة: PDF, Word (doc/docx), صور, Excel (الحد الأقصى: 50 ميجابايت)</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Document Name -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_name"
                                  Label="عنوان / اسم المستند *"
                                  Required="true"
                                  RequiredError="اسم المستند مطلوب"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Document Type -->
                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                               Label="نوع / تصنيف المستند"
                               @bind-Value="_documentTypeId"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var type in _documentTypes)
                        {
                            <MudSelectItem Value="@((int?)type.Id)">@type.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Linked Case -->
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?"
                               Label="القضية المرتبطة"
                               @bind-Value="_caseId"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var c in _cases)
                        {
                            <MudSelectItem Value="@((Guid?)c.Id)">@c.InternalNumber - @c.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Linked Client -->
                <MudItem xs="12">
                    <MudSelect T="Guid?"
                               Label="الموكل المرتبط"
                               @bind-Value="_clientId"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var client in _clients)
                        {
                            var clientName = client.ClientType == ClientType.Company ? client.CompanyName : client.FullName;
                            <MudSelectItem Value="@((Guid?)client.Id)">@clientName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Description & Notes -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_description"
                                  Label="وصف محتوى المستند"
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">إلغاء</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSaving || _selectedBrowserFile == null)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
                <span>جاري رفع وحفظ المستند...</span>
            }
            else
            {
                <span>رفع وتوثيق المستند</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid? PreselectedCaseId { get; set; }

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving = false;

    private string _name = string.Empty;
    private int? _documentTypeId;
    private Guid? _caseId;
    private Guid? _clientId;
    private string? _description;
    private IBrowserFile? _selectedBrowserFile;

    private List<LookupDto> _documentTypes = [];
    private List<CaseDto> _cases = [];
    private List<ClientDto> _clients = [];

    protected override async Task OnInitializedAsync()
    {
        _caseId = PreselectedCaseId;

        try
        {
            var typesTask = Mediator.Send(new GetDocumentTypesQuery());
            var casesTask = Mediator.Send(new GetCasesQuery(PageSize: 100));
            var clientsTask = Mediator.Send(new GetClientsQuery(PageSize: 100));

            await Task.WhenAll(typesTask, casesTask, clientsTask);

            if (typesTask.Result.IsSuccess && typesTask.Result.Value != null)
                _documentTypes = typesTask.Result.Value.ToList();

            if (casesTask.Result.IsSuccess && casesTask.Result.Value != null)
                _cases = casesTask.Result.Value.ToList();

            if (clientsTask.Result.IsSuccess && clientsTask.Result.Value != null)
                _clients = clientsTask.Result.Value.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            _selectedBrowserFile = e.File;
            if (string.IsNullOrWhiteSpace(_name))
            {
                _name = Path.GetFileNameWithoutExtension(e.File.Name);
            }
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid)
            return;

        if (_selectedBrowserFile == null)
        {
            Snackbar.Add("يرجى اختيار ملف لرفعه أولاً", Severity.Warning);
            return;
        }

        _isSaving = true;
        var userName = AuthStateProvider.CurrentUser?.FullName ?? "SystemUser";

        try
        {
            using var ms = new MemoryStream();
            await _selectedBrowserFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            IFormFile formFile = new FormFile(ms, 0, ms.Length, _selectedBrowserFile.Name, _selectedBrowserFile.Name)
            {
                Headers = new HeaderDictionary(),
                ContentType = string.IsNullOrEmpty(_selectedBrowserFile.ContentType) ? "application/octet-stream" : _selectedBrowserFile.ContentType
            };

            var uploadResult = await FileService.UploadFileAsync(formFile, "uploads/documents");
            if (!uploadResult.IsSuccess)
            {
                Snackbar.Add($"فشل رفع الملف: {uploadResult.Error.Name}", Severity.Error);
                return;
            }

            var filePath = uploadResult.Value ?? string.Empty;

            var command = new CreateDocumentCommand(
                _caseId,
                _clientId,
                _documentTypeId,
                _name,
                _description,
                filePath,
                _selectedBrowserFile.Name,
                _selectedBrowserFile.ContentType,
                _selectedBrowserFile.Size,
                null,
                userName);

            var result = await Mediator.Send(command);
            if (result.IsSuccess)
            {
                Snackbar.Add("تم رفع وتوثيق المستند بنجاح", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error.Name, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء رفع المستند: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
