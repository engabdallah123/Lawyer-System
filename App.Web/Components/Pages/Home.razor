@page "/"
@using global::App.Application.Cases.DTOs
@using global::App.Application.Cases.Queries.GetCases
@using global::App.Application.Clients.Queries.GetClients
@using global::App.Application.Dashboard.Queries.GetOwnerDashboard
@using global::App.Application.Hearings.DTOs
@using global::App.Application.Hearings.Queries.GetHearings
@using global::App.Application.Hearings.Queries.GetTodayHearings
@using global::App.Application.Tasks.Commands.CompleteLegalTask
@using global::App.Application.Tasks.DTOs
@using global::App.Application.Tasks.Queries.GetOverdueTasks
@using global::App.Web.Components.Pages.Cases.Dialogs
@using global::App.Web.Components.Pages.Clients.Dialogs
@using global::App.Web.Components.Pages.Finance.Dialogs
@using global::App.Web.Components.Pages.Hearings.Dialogs
@using global::App.Web.Components.Pages.Tasks.Dialogs
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CustomAuthenticationStateProvider AuthStateProvider

<PageTitle>لوحة القيادة والمتابعة | نظام إدارة مكاتب المحاماة</PageTitle>

<!-- Executive Welcome Hero Banner -->
<div class="hero-banner pa-6 pa-md-8 mb-6">
    <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-4" style="position: relative; z-index: 1;">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Style="background: rgba(197, 160, 89, 0.2); color: #d4af37; font-weight: 700; border: 1px solid rgba(197, 160, 89, 0.4);">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="me-1" /> المنظومة القانونية المتقدمة
                </MudChip>
                <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.7);">@DateTime.Now.ToString("dddd، d MMMM yyyy")</MudText>
            </div>
            <MudText Typo="Typo.h4" Class="fw-extrabold text-white mb-2">
                أهلاً بك، @(AuthStateProvider.CurrentUser?.FullName ?? "المحامي المستشار")
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255, 255, 255, 0.85); max-width: 680px;">
                ملخص متابعة العمليات القانونية وحالة القضايا المفتوحة، الجلسات المجدولة اليوم بالمحاكم، والتكاليف العاجلة التي تتطلب اتخاذ إجراء.
            </MudText>
        </div>

        <!-- Quick Action Toolbar Buttons -->
        <div class="d-flex flex-wrap align-center gap-2">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Gavel" Class="btn-gold-gradient" OnClick="OpenNewCaseDialog">
                فتح قضية جديدة
            </MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd" Color="Color.Surface" Style="color: #0f172a; font-weight: 700;" OnClick="OpenNewClientDialog">
                موكل جديد
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Event" Style="color: #ffffff; border-color: rgba(255,255,255,0.4); font-weight: 700;" OnClick="OpenNewHearingDialog">
                جدولة جلسة
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ReceiptLong" Style="color: #ffffff; border-color: rgba(255,255,255,0.4); font-weight: 700;" OnClick="OpenNewInvoiceDialog">
                فاتورة أتعاب
            </MudButton>
        </div>
    </div>
</div>

<!-- Key Performance Metrics Cards -->
<MudGrid Spacing="3" Class="mb-6">
    <!-- Active Cases Card -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="glass-card stat-card-luxury stat-accent-blue">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold d-block mb-1">القضايا والدعاوى النشطة</MudText>
                    <MudText Typo="Typo.h4" Class="fw-extrabold text-primary mb-1">@_activeCasesCount</MudText>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">قضايا قيد الترافع بالمحاكم</MudText>
                    </div>
                </div>
                <div class="icon-box-blue shadow-sm">
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Large" />
                </div>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Today Hearings Card -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="glass-card stat-card-luxury stat-accent-gold">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold d-block mb-1">جلسات المحاكم اليوم</MudText>
                    <MudText Typo="Typo.h4" Class="fw-extrabold mb-1" Style="color: #c5a059;">@_todayHearings.Count</MudText>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Size="Size.Small" Color="@(_todayHearings.Count > 0 ? Color.Error : Color.Secondary)" />
                        <MudText Typo="Typo.caption" Color="@(_todayHearings.Count > 0 ? Color.Error : Color.Secondary)" Class="fw-bold">
                            @(_todayHearings.Count > 0 ? "تتطلب الحضور بالمحكمة" : "لا توجد جلسات اليوم")
                        </MudText>
                    </div>
                </div>
                <div class="icon-box-gold shadow-sm">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" />
                </div>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Registered Clients Card -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="glass-card stat-card-luxury stat-accent-emerald">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold d-block mb-1">الموكلين المسجلين</MudText>
                    <MudText Typo="Typo.h4" Class="fw-extrabold text-success mb-1">@_clientsCount</MudText>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Success" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">ملفات الموكلين التراكمية</MudText>
                    </div>
                </div>
                <div class="icon-box-emerald shadow-sm">
                    <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Large" />
                </div>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Overdue & Urgent Tasks Card -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="glass-card stat-card-luxury stat-accent-crimson">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold d-block mb-1">المهام العاجلة والمتأخرة</MudText>
                    <MudText Typo="Typo.h4" Class="fw-extrabold text-error mb-1">@_overdueTasks.Count</MudText>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Error" />
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="fw-bold">تستوجب الإنجاز الفوري</MudText>
                    </div>
                </div>
                <div class="icon-box-crimson shadow-sm">
                    <MudIcon Icon="@Icons.Material.Filled.ChecklistRtl" Size="Size.Large" />
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Main Workspace Grid: Hearings & Urgent Tasks -->
<MudGrid Spacing="3">
    <!-- Scheduled Court Hearings Section -->
    <MudItem xs="12" md="8">
        <MudCard Elevation="0" Class="glass-card h-100">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Class="shadow-sm">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Style="color: #c5a059;" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">أحدث جلسات المحاكم المجدولة</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">المواعيد القادمة بالمحاكم والدوائر القضائية</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="hearings" EndIcon="@Icons.Material.Filled.ArrowBack" Class="fw-bold">
                        عرض كافة الجلسات
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                @if (_hearings.Count == 0)
                {
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" Color="Color.Secondary" Class="mb-2 opacity-50" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="fw-bold">لا توجد جلسات محاكم مجدولة حالياً</MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_hearings.Take(5)" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                        <HeaderContent>
                            <MudTh>رقم القضية</MudTh>
                            <MudTh>موضوع القضية</MudTh>
                            <MudTh>المحكمة / الدائرة</MudTh>
                            <MudTh>الموعد</MudTh>
                            <MudTh>نوع الجلسة</MudTh>
                            <MudTh Style="text-align: center;">الإجراء</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="رقم القضية"><span class="fw-bold text-primary">@context.CaseInternalNumber</span></MudTd>
                            <MudTd DataLabel="الموضوع"><span class="fw-semibold">@context.CaseTitle</span></MudTd>
                            <MudTd DataLabel="المحكمة">@(context.CourtName ?? "-")</MudTd>
                            <MudTd DataLabel="الموعد">
                                <span class="fw-bold">@context.HearingDate.ToString("yyyy/MM/dd")</span>
                                @if (context.HearingTime.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">@context.HearingTime.Value.ToString(@"hh\:mm")</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="النوع"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="fw-bold">@context.HearingType</MudChip></MudTd>
                            <MudTd Style="text-align: center;">
                                <MudTooltip Text="تسجيل قرار ونتيجة الجلسة">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenRecordResultDialog(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Urgent Legal Tasks Section -->
    <MudItem xs="12" md="4">
        <MudCard Elevation="0" Class="glass-card h-100">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium" Class="shadow-sm">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">المهام والمتابعات العاجلة</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">المطلوب إنجازه فورياً</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudTooltip Text="إضافة مهمة جديدة">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="OpenNewTaskDialog" />
                    </MudTooltip>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-3">
                @if (_overdueTasks.Count == 0)
                {
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold text-success">رائع! تم إنجاز كافة المهام العاجلة</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">جميع الأعمال القانونية تسير وفق المخطط</MudText>
                    </div>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var task in _overdueTasks.Take(5))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.RadioButtonUnchecked" IconColor="Color.Error" Class="py-2">
                                <div class="d-flex justify-space-between align-center w-100">
                                    <div class="me-2">
                                        <MudText Typo="Typo.body2" Class="fw-bold">@task.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            الاستحقاق: @(task.DueDate?.ToString("yyyy/MM/dd") ?? "غير محدد")
                                        </MudText>
                                    </div>
                                    <MudTooltip Text="إكمال المهمة فوراً">
                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Small" OnClick="@(() => MarkTaskComplete(task))" />
                                    </MudTooltip>
                                </div>
                            </MudListItem>
                            <MudDivider Class="my-1" />
                        }
                    </MudList>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _activeCasesCount = 0;
    private int _clientsCount = 0;
    private List<HearingDto> _todayHearings = [];
    private List<HearingDto> _hearings = [];
    private List<LegalTaskDto> _overdueTasks = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var casesTask = Mediator.Send(new GetCasesQuery(PageSize: 100));
            var clientsTask = Mediator.Send(new GetClientsQuery(PageSize: 100));
            var todayHearingsTask = Mediator.Send(new GetTodayHearingsQuery());
            var allHearingsTask = Mediator.Send(new GetHearingsQuery(PageSize: 10));
            var overdueTasksTask = Mediator.Send(new GetOverdueTasksQuery());

            await Task.WhenAll(casesTask, clientsTask, todayHearingsTask, allHearingsTask, overdueTasksTask);

            if (casesTask.Result.IsSuccess && casesTask.Result.Value != null)
                _activeCasesCount = casesTask.Result.Value.Count(c => c.CloseDate == null);

            if (clientsTask.Result.IsSuccess && clientsTask.Result.Value != null)
                _clientsCount = clientsTask.Result.Value.Count();

            if (todayHearingsTask.Result.IsSuccess && todayHearingsTask.Result.Value != null)
                _todayHearings = todayHearingsTask.Result.Value.ToList();

            if (allHearingsTask.Result.IsSuccess && allHearingsTask.Result.Value != null)
                _hearings = allHearingsTask.Result.Value.ToList();

            if (overdueTasksTask.Result.IsSuccess && overdueTasksTask.Result.Value != null)
                _overdueTasks = overdueTasksTask.Result.Value.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تحميل بيانات لوحة التحكم: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenNewClientDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ClientFormDialog>("إضافة موكل جديد", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDashboardData();
    }

    private async Task OpenNewCaseDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateCaseDialog>("فتح ملف قضية جديدة", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDashboardData();
    }

    private async Task OpenNewHearingDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateHearingDialog>("جدولة موعد جلسة بالمحكمة", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDashboardData();
    }

    private async Task OpenNewInvoiceDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateInvoiceDialog>("إصدار فاتورة أتعاب", options);
        await dialog.Result;
    }

    private async Task OpenNewTaskDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateTaskDialog>("تكليف مهمة عمل جديدة", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDashboardData();
    }

    private async Task OpenRecordResultDialog(HearingDto hearing)
    {
        var parameters = new DialogParameters { ["HearingItem"] = hearing };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RecordHearingResultDialog>("توثيق وتسجيل قرار الجلسة", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await LoadDashboardData();
    }

    private async Task MarkTaskComplete(LegalTaskDto task)
    {
        var userName = AuthStateProvider.CurrentUser?.FullName ?? "SystemUser";
        var result = await Mediator.Send(new CompleteLegalTaskCommand(task.Id, userName));
        if (result.IsSuccess)
        {
            Snackbar.Add("تم إنجاز المهمة بنجاح", Severity.Success);
            await LoadDashboardData();
        }
    }
}
