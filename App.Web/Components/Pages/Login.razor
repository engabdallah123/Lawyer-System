@page "/login"
@inject IIdentityService IdentityService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>تسجيل الدخول | نظام إدارة مكاتب المحاماة</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 80vh;">
    <MudPaper Elevation="4" Class="pa-6 pa-md-8 glass-card border rounded-xl" Style="max-width: 480px; width: 100%;">
        <!-- Header / Logo -->
        <div class="text-center mb-6">
            <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="fw-bold" Color="Color.Primary">
                نظام إدارة مكاتب المحاماة
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                تسجيل الدخول إلى حسابك لمتابعة القضايا والأعمال
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        <!-- Login Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_loginModel.Email"
                          Label="البريد الإلكتروني"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Margin="Margin.Dense"
                          Class="mb-4"
                          For="@(() => _loginModel.Email)"
                          Required="true" />

            <MudTextField @bind-Value="_loginModel.Password"
                          Label="كلمة المرور"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Margin="Margin.Dense"
                          Class="mb-6"
                          For="@(() => _loginModel.Password)"
                          Required="true" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="py-2"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">جاري التحقق...</span>
                }
                else
                {
                    <span>تسجيل الدخول</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-6" />

        <!-- Quick Demo / Testing Accounts -->
        <div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-center mb-2 fw-bold">
                حسابات تجريبية سريعة (Seeded Accounts)
            </MudText>
            <MudStack Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                           OnClick="@(() => SetCredentials("admin@lawyer.com", "Admin@123456"))">
                    دخول كـ مدير النظام (Admin)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Gavel"
                           OnClick="@(() => SetCredentials("lawyer@lawyer.com", "Lawyer@123456"))">
                    دخول كـ محامي (Lawyer)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Person"
                           OnClick="@(() => SetCredentials("staff@lawyer.com", "Staff@123456"))">
                    دخول كـ موظف عادي (Staff)
                </MudButton>
            </MudStack>
        </div>
    </MudPaper>
</div>

@code {
    private LoginViewModel _loginModel = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private bool _showPassword = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_showPassword)
        {
            _showPassword = false;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _showPassword = true;
            _passwordIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private void SetCredentials(string email, string password)
    {
        _loginModel.Email = email;
        _loginModel.Password = password;
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await IdentityService.AuthenticateAsync(_loginModel.Email, _loginModel.Password);
            if (result.IsSuccess && result.Value != null)
            {
                AuthStateProvider.MarkUserAsAuthenticated(result.Value);
                Snackbar.Add($"مرحباً بك، {result.Value.FullName} ({AppRoles.GetArabicName(result.Value.Role)})", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = result.Error.Name;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"حدث خطأ أثناء محاولة تسجيل الدخول: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "البريد الإلكتروني غير صحيح")]
        public string Email { get; set; } = "admin@lawyer.com";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "كلمة المرور مطلوبة")]
        public string Password { get; set; } = "Admin@123456";
    }
}
