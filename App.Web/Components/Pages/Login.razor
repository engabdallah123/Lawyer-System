@page "/login"
@using global::App.Infrastructure.Identity.DTOs
@using global::App.Infrastructure.Identity.Services
@inject IIdentityService IdentityService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>تسجيل الدخول | مكتب المستشار علاء خالد علام</PageTitle>

<div class="login-bg-container">
    <MudPaper Elevation="8" Class="pa-6 pa-sm-8 pa-md-10 login-card rounded-xl" Style="max-width: 440px; width: 100%; position: relative; z-index: 10;">
        
        <!-- Header / Logo -->
        <div class="text-center mb-6">
            <div class="d-inline-block pa-2 rounded-circle mb-3 shadow-md" style="background: rgba(197, 160, 89, 0.12); border: 2px solid #c5a059;">
                <img src="/Images/logo.png" alt="الشعار الرسمى" style="height: 52px; width: auto; object-fit: contain; display: block;" />
            </div>

            <MudText Typo="Typo.h6" Class="fw-extrabold mb-1" Style="letter-spacing: -0.3px;">
                مكتب المستشار / علاء خالد علام
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold d-block mb-1">
                Alaa Khaled Allam — Advocate & Legal Consultant
            </MudText>
            <MudChip T="string" Size="Size.Small" Style="background: rgba(197, 160, 89, 0.15); color: #c5a059; font-weight: 700;" Class="mt-1">
                تسجيل الدخول إلى المنظومة
            </MudChip>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        <!-- Clean Direct Login Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <MudTextField @bind-Value="_loginModel.Email"
                              Label="البريد الإلكتروني"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Margin="Margin.Dense"
                              For="@(() => _loginModel.Email)"
                              Required="true" />
            </div>

            <div class="mb-6">
                <MudTextField @bind-Value="_loginModel.Password"
                              Label="كلمة المرور"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Margin="Margin.Dense"
                              For="@(() => _loginModel.Password)"
                              Required="true" />
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="py-3 rounded-pill btn-gold-gradient shadow-lg mb-3"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2 fw-bold">جاري التحقق من الهوية...</span>
                }
                else
                {
                    <span class="fw-bold">دخول إلى النظام</span>
                }
            </MudButton>
        </EditForm>

        <div class="text-center mt-4">
            <MudLink Href="/landing" Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold underline-on-hover">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="me-1 align-text-bottom" /> العودة إلى الصفحة الرئيسية
            </MudLink>
        </div>
    </MudPaper>
</div>

@code {
    private LoginViewModel _loginModel = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private bool _showPassword = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_showPassword)
        {
            _showPassword = false;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _showPassword = true;
            _passwordIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await IdentityService.AuthenticateAsync(_loginModel.Email, _loginModel.Password);
            if (result.IsSuccess && result.Value != null)
            {
                AuthStateProvider.MarkUserAsAuthenticated(result.Value);
                Snackbar.Add($"مرحباً بك، {result.Value.FullName} ({AppRoles.GetArabicName(result.Value.Role)})", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = result.Error.Name;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"حدث خطأ أثناء محاولة تسجيل الدخول: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "البريد الإلكتروني غير صحيح")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "كلمة المرور مطلوبة")]
        public string Password { get; set; } = string.Empty;
    }
}
