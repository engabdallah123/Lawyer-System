@page "/login"
@using global::App.Infrastructure.Identity.DTOs
@using global::App.Infrastructure.Identity.Services
@inject IIdentityService IdentityService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>تسجيل الدخول | المنظومة القانونية المتقدمة</PageTitle>

<div class="login-bg-container">
    <MudPaper Elevation="8" Class="pa-6 pa-md-10 login-card rounded-xl" Style="max-width: 480px; width: 100%; position: relative; z-index: 10;">
        <!-- Header / Logo -->
        <div class="text-center mb-6">
            <MudAvatar Size="Size.Large" Class="mb-3 shadow-lg" Style="background: linear-gradient(135deg, #c5a059 0%, #d4af37 100%); width: 72px; height: 72px; margin: 0 auto; border: 3px solid rgba(255,255,255,0.2);">
                <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Large" Style="color: #0f172a;" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="fw-extrabold text-white mb-1" Style="letter-spacing: -0.5px;">
                نظام إدارة مكاتب المحاماة
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #c5a059;" Class="fw-bold">
                المنظومة الذكية لإدارة القضايا والخدمات القانونية
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        <!-- Login Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <MudText Typo="Typo.caption" Class="fw-bold text-white mb-1 d-block">البريد الإلكتروني</MudText>
                <MudTextField @bind-Value="_loginModel.Email"
                              Placeholder="name@lawyer.com"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Margin="Margin.Dense"
                              Class="search-input-pill"
                              For="@(() => _loginModel.Email)"
                              Required="true" />
            </div>

            <div class="mb-6">
                <MudText Typo="Typo.caption" Class="fw-bold text-white mb-1 d-block">كلمة المرور</MudText>
                <MudTextField @bind-Value="_loginModel.Password"
                              Placeholder="••••••••"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Margin="Margin.Dense"
                              Class="search-input-pill"
                              For="@(() => _loginModel.Password)"
                              Required="true" />
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="py-3 rounded-pill btn-gold-gradient"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2 fw-bold">جاري التحقق من الهوية...</span>
                }
                else
                {
                    <span class="fw-bold">دخول إلى النظام</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-6" Style="border-color: rgba(197, 160, 89, 0.2);" />

        <!-- Quick Demo Accounts -->
        <div>
            <MudText Typo="Typo.caption" Style="color: rgba(255, 255, 255, 0.7);" Class="d-block text-center mb-3 fw-bold">
                حسابات تجريبية سريعة (Click to Fill Credentials)
            </MudText>
            <MudStack Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="rounded-lg"
                           Style="border-color: rgba(197, 160, 89, 0.4); color: #d4af37; background: rgba(197, 160, 89, 0.08); font-weight: 700;"
                           StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                           OnClick="@(() => SetCredentials("admin@lawyer.com", "Admin@123456"))">
                    مدير النظام (Administrator)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="rounded-lg"
                           Style="border-color: rgba(37, 99, 235, 0.4); color: #60a5fa; background: rgba(37, 99, 235, 0.08); font-weight: 700;"
                           StartIcon="@Icons.Material.Filled.Gavel"
                           OnClick="@(() => SetCredentials("lawyer@lawyer.com", "Lawyer@123456"))">
                    محامي ومستشار (Lawyer)
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="rounded-lg"
                           Style="border-color: rgba(16, 185, 129, 0.4); color: #34d399; background: rgba(16, 185, 129, 0.08); font-weight: 700;"
                           StartIcon="@Icons.Material.Filled.Person"
                           OnClick="@(() => SetCredentials("staff@lawyer.com", "Staff@123456"))">
                    موظف إداري (Staff)
                </MudButton>
            </MudStack>
        </div>
    </MudPaper>
</div>

@code {
    private LoginViewModel _loginModel = new();
    private bool _isLoading = false;
    private string? _errorMessage;
    private bool _showPassword = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (_showPassword)
        {
            _showPassword = false;
            _passwordIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _showPassword = true;
            _passwordIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private void SetCredentials(string email, string password)
    {
        _loginModel.Email = email;
        _loginModel.Password = password;
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await IdentityService.AuthenticateAsync(_loginModel.Email, _loginModel.Password);
            if (result.IsSuccess && result.Value != null)
            {
                AuthStateProvider.MarkUserAsAuthenticated(result.Value);
                Snackbar.Add($"مرحباً بك، {result.Value.FullName} ({AppRoles.GetArabicName(result.Value.Role)})", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = result.Error.Name;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"حدث خطأ أثناء محاولة تسجيل الدخول: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginViewModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "البريد الإلكتروني غير صحيح")]
        public string Email { get; set; } = "admin@lawyer.com";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "كلمة المرور مطلوبة")]
        public string Password { get; set; } = "Admin@123456";
    }
}
