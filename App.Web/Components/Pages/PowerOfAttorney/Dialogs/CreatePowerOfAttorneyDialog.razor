@using global::App.Application.Cases.DTOs
@using global::App.Application.Cases.Queries.GetCases
@using global::App.Application.Clients.DTOs
@using global::App.Application.Clients.Queries.GetClients
@using global::App.Application.PowerOfAttorney.Commands.CreatePowerOfAttorney
@using global::App.Domain.Clients.Enums
@using Microsoft.AspNetCore.Http
@using Shared.Application.IService
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IFileService FileService
@inject CustomAuthenticationStateProvider AuthStateProvider

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <!-- Client Selection -->
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid"
                               Label="الموكل (صاحب التوكيل) *"
                               @bind-Value="_clientId"
                               Required="true"
                               RequiredError="يرجى اختيار الموكل"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var client in _clients)
                        {
                            var clientName = client.ClientType == ClientType.Company ? client.CompanyName : client.FullName;
                            <MudSelectItem Value="@client.Id">@clientName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Optional Linked Case -->
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?"
                               Label="ربط بقضية محددة (اختياري)"
                               @bind-Value="_caseId"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var c in _cases)
                        {
                            <MudSelectItem Value="@((Guid?)c.Id)">@c.InternalNumber - @c.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Power Number & Notary -->
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_powerNumber"
                                  Label="رقم التوكيل الرسمي *"
                                  Required="true"
                                  RequiredError="رقم التوكيل مطلوب"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_notaryName"
                                  Label="جهة / كتابة العدل المصدرة"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- Issue Date & Expiry Date -->
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_issueDate"
                                   Label="تاريخ إصدار التوكيل *"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_expiryDate"
                                   Label="تاريخ انتهاء السريان (إن وجد)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <!-- File Upload for Power of Attorney Scan -->
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3 border-dashed rounded-lg bg-surface-subtle text-center">
                        <InputFile id="poaFileInput" OnChange="OnFileSelected" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                        <MudButton HtmlTag="label"
                                   for="poaFileInput"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   Size="Size.Small">
                            رفع صورة أو ملف التوكيل (PDF / صور)
                        </MudButton>

                        @if (_selectedBrowserFile != null)
                        {
                            <div class="d-flex align-center justify-center gap-2 mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Class="fw-bold text-success">@_selectedBrowserFile.Name</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@FormatFileSize(_selectedBrowserFile.Size)</MudChip>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Notes -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes"
                                  Label="ملاحظات وحدود صلاحيات التوكيل"
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">إلغاء</MudButton>
        <MudButton Color="Color.Secondary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
                <span>جاري الحفظ...</span>
            }
            else
            {
                <span>حفظ التوكيل</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid? DefaultClientId { get; set; }

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving = false;

    private Guid _clientId;
    private Guid? _caseId;
    private string _powerNumber = string.Empty;
    private DateTime? _issueDate = DateTime.Today;
    private DateTime? _expiryDate = DateTime.Today.AddYears(1);
    private string? _notaryName;
    private string? _notes;
    private IBrowserFile? _selectedBrowserFile;

    private List<ClientDto> _clients = [];
    private List<CaseDto> _cases = [];

    protected override async Task OnInitializedAsync()
    {
        if (DefaultClientId.HasValue)
            _clientId = DefaultClientId.Value;

        try
        {
            var clientsTask = Mediator.Send(new GetClientsQuery(PageSize: 100));
            var casesTask = Mediator.Send(new GetCasesQuery(PageSize: 100));

            await Task.WhenAll(clientsTask, casesTask);

            if (clientsTask.Result.IsSuccess && clientsTask.Result.Value != null)
            {
                _clients = clientsTask.Result.Value.ToList();
                if (_clientId == Guid.Empty && _clients.Count > 0)
                    _clientId = _clients[0].Id;
            }

            if (casesTask.Result.IsSuccess && casesTask.Result.Value != null)
            {
                _cases = casesTask.Result.Value.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ أثناء تحميل البيانات: {ex.Message}", Severity.Error);
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            _selectedBrowserFile = e.File;
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid || _clientId == Guid.Empty)
            return;

        _isSaving = true;
        var userName = AuthStateProvider.CurrentUser?.FullName ?? "SystemUser";

        try
        {
            string? uploadedFilePath = null;

            if (_selectedBrowserFile != null)
            {
                using var ms = new MemoryStream();
                await _selectedBrowserFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(ms);
                ms.Position = 0;

                IFormFile formFile = new FormFile(ms, 0, ms.Length, _selectedBrowserFile.Name, _selectedBrowserFile.Name)
                {
                    Headers = new HeaderDictionary(),
                    ContentType = string.IsNullOrEmpty(_selectedBrowserFile.ContentType) ? "application/octet-stream" : _selectedBrowserFile.ContentType
                };

                var uploadResult = await FileService.UploadFileAsync(formFile, "uploads/power-of-attorneys");
                if (uploadResult.IsSuccess)
                {
                    uploadedFilePath = uploadResult.Value;
                }
            }

            var command = new CreatePowerOfAttorneyCommand(
                _clientId,
                _caseId,
                _powerNumber,
                _issueDate ?? DateTime.Today,
                _expiryDate,
                _notaryName,
                null,
                uploadedFilePath,
                _notes,
                userName);

            var result = await Mediator.Send(command);
            if (result.IsSuccess)
            {
                Snackbar.Add("تم تسجيل التوكيل الرسمي ورفع الملف بنجاح", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error.Name, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
