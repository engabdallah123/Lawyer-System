@inject IIdentityService IdentityService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                إعادة تعيين كلمة المرور للمستخدم: <b>@User.FullName</b> (@User.Email)
            </MudText>

            <MudTextField @bind-Value="_newPassword"
                          Label="كلمة المرور الجديدة *"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="كلمة المرور مطلوبة"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="تأكيد كلمة المرور *"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="تأكيد كلمة المرور مطلوب"
                          Validation="@((string val) => val == _newPassword ? null : "كلمتا المرور غير متطابقتين")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">إلغاء</MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-2" />
                <span>جاري التغيير...</span>
            }
            else
            {
                <span>تغيير كلمة المرور</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserDto User { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSaving = false;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid)
            return;

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("كلمتا المرور غير متطابقتين", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var result = await IdentityService.ResetPasswordAsync(User.Id, _newPassword);
            if (result.IsSuccess)
            {
                Snackbar.Add("تمت إعادة تعيين كلمة المرور بنجاح", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error.Name, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"حدث خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
